#: settingsPanel.py:84
msgid "&Application rules (one per line: name=off, name=main or name=alt):"
msgstr "應用程式規則 (&A)（每行一個：name=off、name=main 或 name=alt）："

#: uTalkCore.py:62
msgid "...truncated"
msgstr "...已截斷"

#: uTalkCore.py:483
msgid "Alternate language"
msgstr "替代語言"

#: settingsPanel.py:57
msgid "Alternate language code:"
msgstr "備用語言代碼："

#: uTalkCore.py:505
msgid "Alternate language is not set. Press the shortcut twice to open the uTalk settings and add phrases."
msgstr "尚未設定替代語言。請按兩下捷徑來開啟 uTalk 設定並新增片語。"

#: settingsPanel.py:79
msgid "Announce copy, cut and paste &only when they take effect"
msgstr "僅在複製、剪下與貼上&生效時才進行朗讀"

#: settingsPanel.py:72
msgid "Announcement &detail:"
msgstr "朗讀&詳細程度："

#: settingsPanel.py:64
msgid "Announcement &output:"
msgstr "朗讀&輸出："

#: settingsPanel.py:19
msgid "Beep only"
msgstr "僅嗶聲"

#: settingsPanel.py:18
msgid "Braille only"
msgstr "僅盲文"

#: uTalkCore.py:466
msgid "Cannot detect the current application"
msgstr "無法偵測目前的應用程式"

#: settingsPanel.py:103
msgid "Command translations:"
msgstr "命令翻譯："

#: settingsPanel.py:92
msgid "Copy"
msgstr "複製"

#: settingsPanel.py:94
msgid "Copy file"
msgstr "複製檔案"

#: settingsPanel.py:93
msgid "Copy path"
msgstr "複製路徑"

#: uTalkCore.py:477
msgid "Could not save the application rule"
msgstr "無法儲存應用程式規則"

#: settingsPanel.py:95
msgid "Cut"
msgstr "剪下"

#: settingsPanel.py:26
msgid "Detailed (adds counts and what undo or redo changed)"
msgstr "詳細（新增計數以及復原或取消復原所變更的內容）"

#: uTalkCore.py:484
msgid "English"
msgstr "英文"

#: settingsPanel.py:130
msgid "Invalid configuration"
msgstr "無效的設定"

#: settingsPanel.py:148
msgid "Line {line} of the application rules is not valid. Use name=off, name=main or name=alt."
msgstr "應用程式規則的第 {line} 行無效。請使用 name=off、name=main 或 name=alt。"

#: uTalkCore.py:449
msgid "Mute or unmute uTalk announcements"
msgstr "將 uTalk 朗讀設為靜音或取消靜音"

#: uTalkCore.py:93
msgid "Nothing to copy"
msgstr "沒有可複製的內容"

#: uTalkCore.py:92
msgid "Nothing to cut"
msgstr "沒有可剪下的內容"

#: settingsPanel.py:96
msgid "Paste"
msgstr "貼上"

#: settingsPanel.py:97
msgid "Redo"
msgstr "重做"

#: settingsPanel.py:115
msgid "Restore Defaults"
msgstr "恢復預設值"

#: settingsPanel.py:98
msgid "Save"
msgstr "儲存"

#: settingsPanel.py:99
msgid "Select all"
msgstr "全選"

#: settingsPanel.py:25
msgid "Short"
msgstr "簡短"

#: settingsPanel.py:16
msgid "Speech and braille"
msgstr "語音與盲文"

#: settingsPanel.py:17
msgid "Speech only"
msgstr "僅語音"

#: settingsPanel.py:134
msgid "The text is longer than {limit} characters. Shorten it before saving."
msgstr "文字長度超過 {limit} 個字元。請在儲存前加以縮短。"

#: uTalkCore.py:459
msgid "Turn uTalk off or on for the current application"
msgstr "切換目前應用程式的 uTalk 開啟或關閉"

#: settingsPanel.py:100
msgid "Undo"
msgstr "復原"

#: uTalkCore.py:134
msgid "added {text}"
msgstr "已新增 {text}"

#: uTalkCore.py:132
msgid "removed {text}"
msgstr "已移除 {text}"

#: uTalkCore.py:127
msgid "replaced {removed} with {added}"
msgstr "已將 {removed} 取代為 {added}"

#: settingsPanel.py:38
#: uTalkCore.py:139
msgid "uTalk"
msgstr "uTalk"

#: uTalkCore.py:436
msgid "uTalk multi tap. Once: swap languages. Twice: open settings. Three times: turn uTalk off or on for the current application. Four times: mute or unmute uTalk announcements"
msgstr "uTalk 多重按壓。按一下：切換語言。按兩下：開啟設定。按三下：切換目前應用程式的 uTalk 開啟或關閉。按四下：將 uTalk 語音朗讀靜音或取消靜音"

#: uTalkCore.py:457
msgid "uTalk muted"
msgstr "uTalk 已靜音"

#: uTalkCore.py:474
msgid "uTalk off for {appName}"
msgstr "uTalk 在 {appName} 中已關閉"

#: uTalkCore.py:471
msgid "uTalk on for {appName}"
msgstr "uTalk 在 {appName} 中已開啟"

#: uTalkCore.py:457
msgid "uTalk unmuted"
msgstr "uTalk 已取消靜音"

#: uTalkCore.py:109
msgid "whitespace"
msgstr "空白字元"