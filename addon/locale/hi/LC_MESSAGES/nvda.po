#: settingsPanel.py:84
msgid "&Application rules (one per line: name=off, name=main or name=alt):"
msgstr "&एप्लिकेशन नियम (प्रति पंक्ति एक: name=off, name=main या name=alt):"

#: uTalkCore.py:62
msgid "...truncated"
msgstr "...काटा गया"

#: uTalkCore.py:483
msgid "Alternate language"
msgstr "वैकल्पिक भाषा"

#: settingsPanel.py:57
msgid "Alternate language code:"
msgstr "वैकल्पिक भाषा कोड:"

#: uTalkCore.py:505
msgid "Alternate language is not set. Press the shortcut twice to open the uTalk settings and add phrases."
msgstr "वैकल्पिक भाषा सेट नहीं है। uTalk सेटिंग्स खोलने और वाक्यांश जोड़ने के लिए शॉर्टकट को दो बार दबाएं।"

#: settingsPanel.py:79
msgid "Announce copy, cut and paste &only when they take effect"
msgstr "कॉपी, कट और पेस्ट की घोषणा &केवल तभी करें जब वे प्रभावी हों"

#: settingsPanel.py:72
msgid "Announcement &detail:"
msgstr "घोषणा का &विवरण:"

#: settingsPanel.py:64
msgid "Announcement &output:"
msgstr "घोषणा का &आउटपुट:"

#: settingsPanel.py:19
msgid "Beep only"
msgstr "केवल बीप"

#: settingsPanel.py:18
msgid "Braille only"
msgstr "केवल ब्रेल"

#: uTalkCore.py:466
msgid "Cannot detect the current application"
msgstr "वर्तमान एप्लिकेशन का पता नहीं लगाया जा सका"

#: settingsPanel.py:103
msgid "Command translations:"
msgstr "कमांड अनुवाद:"

#: settingsPanel.py:92
msgid "Copy"
msgstr "कॉपी करें"

#: settingsPanel.py:94
msgid "Copy file"
msgstr "फाइल कॉपी करें"

#: settingsPanel.py:93
msgid "Copy path"
msgstr "पाथ कॉपी करें"

#: uTalkCore.py:477
msgid "Could not save the application rule"
msgstr "एप्लिकेशन नियम सहेजा नहीं जा सका"

#: settingsPanel.py:95
msgid "Cut"
msgstr "कट करें"

#: settingsPanel.py:26
msgid "Detailed (adds counts and what undo or redo changed)"
msgstr "विस्तृत (गिनती जोड़ता है और यह बताता है कि पूर्ववत करें या फिर से करें ने क्या बदला)"

#: uTalkCore.py:484
msgid "English"
msgstr "अंग्रेज़ी"

#: settingsPanel.py:130
msgid "Invalid configuration"
msgstr "अमान्य कॉन्फ़िगरेशन"

#: settingsPanel.py:148
msgid "Line {line} of the application rules is not valid. Use name=off, name=main or name=alt."
msgstr "एप्लिकेशन नियमों की लाइन {line} मान्य नहीं है। name=off, name=main या name=alt का उपयोग करें।"

#: uTalkCore.py:449
msgid "Mute or unmute uTalk announcements"
msgstr "uTalk घोषणाओं को म्यूट या अनम्यूट करें"

#: uTalkCore.py:93
msgid "Nothing to copy"
msgstr "कॉपी करने के लिए कुछ नहीं है"

#: uTalkCore.py:92
msgid "Nothing to cut"
msgstr "कट करने के लिए कुछ नहीं है"

#: settingsPanel.py:96
msgid "Paste"
msgstr "पेस्ट करें"

#: settingsPanel.py:97
msgid "Redo"
msgstr "फिर से करें"

#: settingsPanel.py:115
msgid "Restore Defaults"
msgstr "डिफ़ॉल्ट रीस्टोर करें"

#: settingsPanel.py:98
msgid "Save"
msgstr "सहेजें"

#: settingsPanel.py:99
msgid "Select all"
msgstr "सभी चुनें"

#: settingsPanel.py:25
msgid "Short"
msgstr "संक्षिप्त"

#: settingsPanel.py:16
msgid "Speech and braille"
msgstr "स्पीच और ब्रेल"

#: settingsPanel.py:17
msgid "Speech only"
msgstr "केवल स्पीच"

#: settingsPanel.py:134
msgid "The text is longer than {limit} characters. Shorten it before saving."
msgstr "यह पाठ {limit} वर्णों से अधिक लंबा है। सहेजने से पहले इसे छोटा करें।"

#: uTalkCore.py:459
msgid "Turn uTalk off or on for the current application"
msgstr "वर्तमान एप्लिकेशन के लिए uTalk बंद या चालू करें"

#: settingsPanel.py:100
msgid "Undo"
msgstr "पूर्वावत करें"

#: uTalkCore.py:134
msgid "added {text}"
msgstr "{text} जोड़ा गया"

#: uTalkCore.py:132
msgid "removed {text}"
msgstr "{text} हटाया गया"

#: uTalkCore.py:127
msgid "replaced {removed} with {added}"
msgstr "{removed} को {added} से बदला गया"

#: settingsPanel.py:38
#: uTalkCore.py:139
msgid "uTalk"
msgstr "uTalk"

#: uTalkCore.py:436
msgid "uTalk multi tap. Once: swap languages. Twice: open settings. Three times: turn uTalk off or on for the current application. Four times: mute or unmute uTalk announcements"
msgstr "uTalk मल्टी टैप। एक बार: भाषाएं बदलें। दो बार: सेटिंग्स खोलें। तीन बार: वर्तमान एप्लिकेशन के लिए uTalk बंद या चालू करें। चार बार: uTalk घोषणाओं को म्यूट या अनम्यूट करें।"

#: uTalkCore.py:457
msgid "uTalk muted"
msgstr "uTalk म्यूट है"

#: uTalkCore.py:474
msgid "uTalk off for {appName}"
msgstr "{appName} के लिए uTalk बंद है"

#: uTalkCore.py:471
msgid "uTalk on for {appName}"
msgstr "{appName} के लिए uTalk चालू है"

#: uTalkCore.py:457
msgid "uTalk unmuted"
msgstr "uTalk अनम्यूट है"

#: uTalkCore.py:109
msgid "whitespace"
msgstr "व्हाइटस्पेस"