#: uTalkCore.py:484
msgid "English"
msgstr "Inglese"

#: settingsPanel.py:130
msgid "Invalid configuration"
msgstr "Configurazione non valida"

#: settingsPanel.py:148
msgid "Line {line} of the application rules is not valid. Use name=off, name=main or name=alt."
msgstr "La riga {line} delle regole per l'applicazione non è valida. Usa nome=off, nome=main o nome=alt."

#: uTalkCore.py:449
msgid "Mute or unmute uTalk announcements"
msgstr "Disattiva o riattiva gli annunci di uTalk"

#: uTalkCore.py:93
msgid "Nothing to copy"
msgstr "Nessun elemento da copiare"

#: uTalkCore.py:92
msgid "Nothing to cut"
msgstr "Nessun elemento da tagliare"

#: settingsPanel.py:96
msgid "Paste"
msgstr "Incolla"

#: settingsPanel.py:97
msgid "Redo"
msgstr "Ripristina"

#: settingsPanel.py:115
msgid "Restore Defaults"
msgstr "Ripristina impostazioni predefinite"

