msgid "Save"
msgstr "Salva"

#: settingsPanel.py:99
msgid "Select all"
msgstr "Seleziona tutto"

#: settingsPanel.py:25
msgid "Short"
msgstr "Breve"

#: settingsPanel.py:16
msgid "Speech and braille"
msgstr "Voce e Braille"

#: settingsPanel.py:17
msgid "Speech only"
msgstr "Solo voce"

#: settingsPanel.py:134
msgid "The text is longer than {limit} characters. Shorten it before saving."
msgstr "Le texte dépasse {limit} caractères. Veuillez l'raccourcir avant d'enregistrer."

#: uTalkCore.py:459
msgid "Turn uTalk off or on for the current application"
msgstr "Activer ou désactiver uTalk pour l'application active"

#: settingsPanel.py:100
msgid "Undo"
msgstr "Annulla"

#: uTalkCore.py:134
msgid "added {text}"
msgstr "{text} ajouté"

#: uTalkCore.py:132
msgid "removed {text}"
msgstr "{text} supprimé"

#: uTalkCore.py:127
msgid "replaced {removed} with {added}"
msgstr "{removed} remplacé par {added}"

