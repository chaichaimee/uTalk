#: uTalkCore.py:139
msgid "uTalk"
msgstr "uTalk"

#: uTalkCore.py:436
msgid "uTalk multi tap. Once: swap languages. Twice: open settings. Three times: turn uTalk off or on for the current application. Four times: mute or unmute uTalk announcements"
msgstr "Multi-appui uTalk. Une fois : inverser les langues. Deux fois : ouvrir les paramètres. Trois fois : activer ou désactiver uTalk pour l'application active. Quatre fois : désactiver ou activer la synthèse vocale de uTalk"

#: uTalkCore.py:457
msgid "uTalk muted"
msgstr "uTalk désactivé vocalement"

#: uTalkCore.py:474
msgid "uTalk off for {appName}"
msgstr "uTalk désactivé pour {appName}"

#: uTalkCore.py:471
msgid "uTalk on for {appName}"
msgstr "uTalk activé pour {appName}"

#: uTalkCore.py:457
msgid "uTalk unmuted"
msgstr "uTalk réactivé vocalement"

#: uTalkCore.py:109
msgid "whitespace"
msgstr "espace"