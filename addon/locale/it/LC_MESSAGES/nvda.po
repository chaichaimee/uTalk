#: settingsPanel.py:84
msgid "&Application rules (one per line: name=off, name=main or name=alt):"
msgstr "&Regole per applicazione (una per riga: nome=off, nome=main o nome=alt):"

#: uTalkCore.py:62
msgid "...truncated"
msgstr "...трункейтед"

#: uTalkCore.py:483
msgid "Alternate language"
msgstr "Lingua alternativa"

#: settingsPanel.py:57
msgid "Alternate language code:"
msgstr "Codice lingua alternativo:"

#: uTalkCore.py:505
msgid "Alternate language is not set. Press the shortcut twice to open the uTalk settings and add phrases."
msgstr "Lingua alternativa non impostata. Premi la scorciatoia due volte per aprire le impostazioni di uTalk e aggiungere frasi."

#: settingsPanel.py:79
msgid "Announce copy, cut and paste &only when they take effect"
msgstr "Annuncia copia, taglia e incolla &solo quando hanno effetto"

#: settingsPanel.py:72
msgid "Announcement &detail:"
msgstr "&Dettaglio annunci:"

#: settingsPanel.py:64
msgid "Announcement &output:"
msgstr "&Output annunci:"

#: settingsPanel.py:19
msgid "Beep only"
msgstr "Solo beep"

#: settingsPanel.py:18
msgid "Braille only"
msgstr "Solo Braille"

#: uTalkCore.py:466
msgid "Cannot detect the current application"
msgstr "Impossibile rilevare l'applicazione corrente"

#: settingsPanel.py:103
msgid "Command translations:"
msgstr "Traduzioni dei comandi:"

#: settingsPanel.py:92
msgid "Copy"
msgstr "Copia"

#: settingsPanel.py:94
msgid "Copy file"
msgstr "Copia file"

#: settingsPanel.py:93
msgid "Copy path"
msgstr "Copia percorso"

#: uTalkCore.py:477
msgid "Could not save the application rule"
msgstr "Impossibile salvare la regola per l'applicazione"

