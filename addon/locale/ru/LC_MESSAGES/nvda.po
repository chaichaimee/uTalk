#: settingsPanel.py:84
msgid "&Application rules (one per line: name=off, name=main or name=alt):"
msgstr "&Правила для приложений (по одному на строку: name=off, name=main или name=alt):"

#: uTalkCore.py:62
msgid "...truncated"
msgstr "...сокращено"

#: uTalkCore.py:483
msgid "Alternate language"
msgstr "Альтернативный язык"

#: settingsPanel.py:57
msgid "Alternate language code:"
msgstr "Альтернативный код языка:"

#: uTalkCore.py:505
msgid "Alternate language is not set. Press the shortcut twice to open the uTalk settings and add phrases."
msgstr "Альтернативный язык не установлен. Нажмите комбинацию клавиш дважды, чтобы открыть настройки uTalk и добавить фразы."

#: settingsPanel.py:79
msgid "Announce copy, cut and paste &only when they take effect"
msgstr "Объявлять о копировании, вырезании и вставке &только при их выполнении"

#: settingsPanel.py:72
msgid "Announcement &detail:"
msgstr "&Подробность объявлений:"

#: settingsPanel.py:64
msgid "Announcement &output:"
msgstr "&Вывод объявлений:"

#: settingsPanel.py:19
msgid "Beep only"
msgstr "Только звуковой сигнал"

#: settingsPanel.py:18
msgid "Braille only"
msgstr "Только шрифт Брайля"

#: uTalkCore.py:466
msgid "Cannot detect the current application"
msgstr "Не удалось определить текущее приложение"

#: settingsPanel.py:103
msgid "Command translations:"
msgstr "Переводы команд:"

#: settingsPanel.py:92
msgid "Copy"
msgstr "Копировать"

#: settingsPanel.py:94
msgid "Copy file"
msgstr "Копировать файл"

#: settingsPanel.py:93
msgid "Copy path"
msgstr "Копировать путь"

#: uTalkCore.py:477
msgid "Could not save the application rule"
msgstr "Не удалось сохранить правило приложения"

#: settingsPanel.py:95
msgid "Cut"
msgstr "Вырезать"

#: settingsPanel.py:26
msgid "Detailed (adds counts and what undo or redo changed)"
msgstr "Подробно (добавляет количество и информацию о том, что изменилось при отмене или повторе)"

#: uTalkCore.py:484
msgid "English"
msgstr "Английский"

#: settingsPanel.py:130
msgid "Invalid configuration"
msgstr "Неверная конфигурация"

#: settingsPanel.py:148
msgid "Line {line} of the application rules is not valid. Use name=off, name=main or name=alt."
msgstr "Строка {line} в правилах для приложений недействительна. Используйте name=off, name=main или name=alt."

#: uTalkCore.py:449
msgid "Mute or unmute uTalk announcements"
msgstr "Включить или выключить звук объявлений uTalk"

#: uTalkCore.py:93
msgid "Nothing to copy"
msgstr "Нечего копировать"

#: uTalkCore.py:92
msgid "Nothing to cut"
msgstr "Нечего вырезать"

#: settingsPanel.py:96
msgid "Paste"
msgstr "Вставить"

#: settingsPanel.py:97
msgid "Redo"
msgstr "Повторить"

#: settingsPanel.py:115
msgid "Restore Defaults"
msgstr "Восстановить настройки по умолчанию"

#: settingsPanel.py:98
msgid "Save"
msgstr "Сохранить"

#: settingsPanel.py:99
msgid "Select all"
msgstr "Выбрать все"

#: settingsPanel.py:25
msgid "Short"
msgstr "Кратко"

#: settingsPanel.py:16
msgid "Speech and braille"
msgstr "Речь и шрифт Брайля"

#: settingsPanel.py:17
msgid "Speech only"
msgstr "Только речь"

#: settingsPanel.py:134
msgid "The text is longer than {limit} characters. Shorten it before saving."
msgstr "Длина текста превышает {limit} символов. Сократите его перед сохранением."

#: uTalkCore.py:459
msgid "Turn uTalk off or on for the current application"
msgstr "Включить или выключить uTalk для текущего приложения"

#: settingsPanel.py:100
msgid "Undo"
msgstr "Отменить"

#: uTalkCore.py:134
msgid "added {text}"
msgstr "добавлено {text}"

#: uTalkCore.py:132
msgid "removed {text}"
msgstr "удалено {text}"

#: uTalkCore.py:127
msgid "replaced {removed} with {added}"
msgstr "заменено {removed} на {added}"

#: settingsPanel.py:38
#: uTalkCore.py:139
msgid "uTalk"
msgstr "uTalk"

#: uTalkCore.py:436
msgid "uTalk multi tap. Once: swap languages. Twice: open settings. Three times: turn uTalk off or on for the current application. Four times: mute or unmute uTalk announcements"
msgstr "Мультитач uTalk. Один раз: переключить языки. Два раза: открыть настройки. Три раза: включить или выключить uTalk для текущего приложения. Четыре раза: выключить или включить звук объявлений uTalk"

#: uTalkCore.py:457
msgid "uTalk muted"
msgstr "Звук uTalk выключен"

#: uTalkCore.py:474
msgid "uTalk off for {appName}"
msgstr "uTalk выключен для {appName}"

#: uTalkCore.py:471
msgid "uTalk on for {appName}"
msgstr "uTalk включен для {appName}"

#: uTalkCore.py:457
msgid "uTalk unmuted"
msgstr "Звук uTalk включен"

#: uTalkCore.py:109
msgid "whitespace"
msgstr "пробел"