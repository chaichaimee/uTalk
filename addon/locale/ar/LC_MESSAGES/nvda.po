#: settingsPanel.py:84
msgid "&Application rules (one per line: name=off, name=main or name=alt):"
msgstr "&قواعد التطبيق (واحدة في كل سطر: name=off، أو name=main، أو name=alt):"

#: uTalkCore.py:62
msgid "...truncated"
msgstr "...مبتور"

#: uTalkCore.py:483
msgid "Alternate language"
msgstr "لغة بديلة"

#: settingsPanel.py:57
msgid "Alternate language code:"
msgstr "رمز اللغة البديل:"

#: uTalkCore.py:505
msgid "Alternate language is not set. Press the shortcut twice to open the uTalk settings and add phrases."
msgstr "اللغة البديلة غير مُعَدَّة. اضغط على الاختصار مرتين لفتح إعدادات uTalk وإضافة العبارات."

#: settingsPanel.py:79
msgid "Announce copy, cut and paste &only when they take effect"
msgstr "إعلان النسخ، والقص، واللصق &فقط عند تنفيذها"

#: settingsPanel.py:72
msgid "Announcement &detail:"
msgstr "ت&فصيل الإعلان:"

#: settingsPanel.py:64
msgid "Announcement &output:"
msgstr "م&خرجات الإعلان:"

#: settingsPanel.py:19
msgid "Beep only"
msgstr "صوت تنبيه فقط"

#: settingsPanel.py:18
msgid "Braille only"
msgstr "برايل فقط"

#: uTalkCore.py:466
msgid "Cannot detect the current application"
msgstr "لا يمكن اكتشاف التطبيق الحالي"

#: settingsPanel.py:103
msgid "Command translations:"
msgstr "ترجمات الأوامر:"

#: settingsPanel.py:92
msgid "Copy"
msgstr "نسخ"

#: settingsPanel.py:94
msgid "Copy file"
msgstr "نسخ الملف"

#: settingsPanel.py:93
msgid "Copy path"
msgstr "نسخ المسار"

#: uTalkCore.py:477
msgid "Could not save the application rule"
msgstr "تعذر حفظ قاعدة التطبيق"

#: settingsPanel.py:95
msgid "Cut"
msgstr "قص"

#: settingsPanel.py:26
msgid "Detailed (adds counts and what undo or redo changed)"
msgstr "مفصل (يضيف الأعداد وما غيره التراجع أو الإعادة)"

#: uTalkCore.py:484
msgid "English"
msgstr "الإنجليزية"

#: settingsPanel.py:130
msgid "Invalid configuration"
msgstr "إعدادات غير صالحة"

#: settingsPanel.py:148
msgid "Line {line} of the application rules is not valid. Use name=off, name=main or name=alt."
msgstr "السطر {line} من قواعد التطبيق غير صالح. استخدم name=off، أو name=main، أو name=alt."

#: uTalkCore.py:449
msgid "Mute or unmute uTalk announcements"
msgstr "كتم أو إلغاء كتم إعلانات uTalk"

#: uTalkCore.py:93
msgid "Nothing to copy"
msgstr "لا يوجد شيء لنسخه"

#: uTalkCore.py:92
msgid "Nothing to cut"
msgstr "لا يوجد شيء لقصّه"

#: settingsPanel.py:96
msgid "Paste"
msgstr "لصق"

#: settingsPanel.py:97
msgid "Redo"
msgstr "إعادة"

#: settingsPanel.py:115
msgid "Restore Defaults"
msgstr "استعادة الافتراضيات"

#: settingsPanel.py:98
msgid "Save"
msgstr "حفظ"

#: settingsPanel.py:99
msgid "Select all"
msgstr "تحديد الكل"

#: settingsPanel.py:25
msgid "Short"
msgstr "قصير"

#: settingsPanel.py:16
msgid "Speech and braille"
msgstr "الكلام وبرايل"

#: settingsPanel.py:17
msgid "Speech only"
msgstr "الكلام فقط"

#: settingsPanel.py:134
msgid "The text is longer than {limit} characters. Shorten it before saving."
msgstr "النص أطول من {limit} حرفاً. يرجى اختصاره قبل الحفظ."

#: uTalkCore.py:459
msgid "Turn uTalk off or on for the current application"
msgstr "إيقاف أو تشغيل uTalk للتطبيق الحالي"

#: settingsPanel.py:100
msgid "Undo"
msgstr "تراجع"

#: uTalkCore.py:134
msgid "added {text}"
msgstr "تمت إضافة {text}"

#: uTalkCore.py:132
msgid "removed {text}"
msgstr "تمت إزالة {text}"

#: uTalkCore.py:127
msgid "replaced {removed} with {added}"
msgstr "استبدال {removed} بـ {added}"

#: settingsPanel.py:38
#: uTalkCore.py:139
msgid "uTalk"
msgstr "uTalk"

#: uTalkCore.py:436
msgid "uTalk multi tap. Once: swap languages. Twice: open settings. Three times: turn uTalk off or on for the current application. Four times: mute or unmute uTalk announcements"
msgstr "النقر المتعدد لـ uTalk. مرة واحدة: تبديل اللغات. مرتان: فتح الإعدادات. ثلاث مرات: إيقاف أو تشغيل uTalk للتطبيق الحالي. أربع مرات: كتم أو إلغاء كتم إعلانات uTalk"

#: uTalkCore.py:457
msgid "uTalk muted"
msgstr "تم كتم uTalk"

#: uTalkCore.py:474
msgid "uTalk off for {appName}"
msgstr "تم إيقاف uTalk لـ {appName}"

#: uTalkCore.py:471
msgid "uTalk on for {appName}"
msgstr "تم تشغيل uTalk لـ {appName}"

#: uTalkCore.py:457
msgid "uTalk unmuted"
msgstr "تم إلغاء كتم uTalk"

#: uTalkCore.py:109
msgid "whitespace"
msgstr "مسافة بيضاء"