#: settingsPanel.py:84
msgid "&Application rules (one per line: name=off, name=main or name=alt):"
msgstr "Aturan &aplikasi (satu per baris: name=off, name=main, atau name=alt):"

#: uTalkCore.py:62
msgid "...truncated"
msgstr "...terpotong"

#: uTalkCore.py:483
msgid "Alternate language"
msgstr "Bahasa alternatif"

#: settingsPanel.py:57
msgid "Alternate language code:"
msgstr "Kode bahasa alternatif:"

#: uTalkCore.py:505
msgid "Alternate language is not set. Press the shortcut twice to open the uTalk settings and add phrases."
msgstr "Bahasa alternatif belum diatur. Tekan pintasan dua kali untuk membuka pengaturan uTalk dan menambahkan frasa."

#: settingsPanel.py:79
msgid "Announce copy, cut and paste &only when they take effect"
msgstr "Umumkan salin, potong, dan tempel &hanya saat diterapkan"

#: settingsPanel.py:72
msgid "Announcement &detail:"
msgstr "&Detail pengumuman:"

#: settingsPanel.py:64
msgid "Announcement &output:"
msgstr "&Keluaran pengumuman:"

#: settingsPanel.py:19
msgid "Beep only"
msgstr "Hanya dering"

#: settingsPanel.py:18
msgid "Braille only"
msgstr "Hanya braille"

#: uTalkCore.py:466
msgid "Cannot detect the current application"
msgstr "Tidak dapat mendeteksi aplikasi saat ini"

#: settingsPanel.py:103
msgid "Command translations:"
msgstr "Terjemahan perintah:"

#: settingsPanel.py:92
msgid "Copy"
msgstr "Salin"

#: settingsPanel.py:94
msgid "Copy file"
msgstr "Salin berkas"

#: settingsPanel.py:93
msgid "Copy path"
msgstr "Salin jalur"

#: uTalkCore.py:477
msgid "Could not save the application rule"
msgstr "Tidak dapat menyimpan aturan aplikasi"

#: settingsPanel.py:95
msgid "Cut"
msgstr "Potong"

#: settingsPanel.py:26
msgid "Detailed (adds counts and what undo or redo changed)"
msgstr "Detail (menambahkan jumlah dan perubahan urungkan atau ulangi)"

#: uTalkCore.py:484
msgid "English"
msgstr "Bahasa Inggris"

#: settingsPanel.py:130
msgid "Invalid configuration"
msgstr "Konfigurasi tidak valid"

#: settingsPanel.py:148
msgid "Line {line} of the application rules is not valid. Use name=off, name=main or name=alt."
msgstr "Baris {line} dari aturan aplikasi tidak valid. Gunakan name=off, name=main, atau name=alt."

#: uTalkCore.py:449
msgid "Mute or unmute uTalk announcements"
msgstr "Bisukan atau bunyikan pengumuman uTalk"

#: uTalkCore.py:93
msgid "Nothing to copy"
msgstr "Tidak ada yang disalin"

#: uTalkCore.py:92
msgid "Nothing to cut"
msgstr "Tidak ada yang dipotong"

#: settingsPanel.py:96
msgid "Paste"
msgstr "Tempel"

#: settingsPanel.py:97
msgid "Redo"
msgstr "Ulangi"

#: settingsPanel.py:115
msgid "Restore Defaults"
msgstr "Pulihkan Default"

#: settingsPanel.py:98
msgid "Save"
msgstr "Simpan"

#: settingsPanel.py:99
msgid "Select all"
msgstr "Pilih semua"

#: settingsPanel.py:25
msgid "Short"
msgstr "Singkat"

#: settingsPanel.py:16
msgid "Speech and braille"
msgstr "Ucapan dan braille"

#: settingsPanel.py:17
msgid "Speech only"
msgstr "Hanya ucapan"

#: settingsPanel.py:134
msgid "The text is longer than {limit} characters. Shorten it before saving."
msgstr "Teks lebih panjang dari {limit} karakter. Singkat sebelum menyimpan."

#: uTalkCore.py:459
msgid "Turn uTalk off or on for the current application"
msgstr "Nonaktifkan atau aktifkan uTalk untuk aplikasi saat ini"

#: settingsPanel.py:100
msgid "Undo"
msgstr "Urungkan"

#: uTalkCore.py:134
msgid "added {text}"
msgstr "ditambahkan {text}"

#: uTalkCore.py:132
msgid "removed {text}"
msgstr "dihapus {text}"

#: uTalkCore.py:127
msgid "replaced {removed} with {added}"
msgstr "mengganti {removed} dengan {added}"

#: settingsPanel.py:38
#: uTalkCore.py:139
msgid "uTalk"
msgstr "uTalk"

#: uTalkCore.py:436
msgid "uTalk multi tap. Once: swap languages. Twice: open settings. Three times: turn uTalk off or on for the current application. Four times: mute or unmute uTalk announcements"
msgstr "Ketuk ganda uTalk. Sekali: tukar bahasa. Dua kali: buka pengaturan. Tiga kali: nonaktifkan atau aktifkan uTalk untuk aplikasi saat ini. Empat kali: bisukan atau batalkan bisu pengumuman uTalk"

#: uTalkCore.py:457
msgid "uTalk muted"
msgstr "uTalk dibisukan"

#: uTalkCore.py:474
msgid "uTalk off for {appName}"
msgstr "uTalk dinonaktifkan untuk {appName}"

#: uTalkCore.py:471
msgid "uTalk on for {appName}"
msgstr "uTalk diaktifkan untuk {appName}"

#: uTalkCore.py:457
msgid "uTalk unmuted"
msgstr "suara uTalk dibunyikan kembali"

#: uTalkCore.py:109
msgid "whitespace"
msgstr "spasi"