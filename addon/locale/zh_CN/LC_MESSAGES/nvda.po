msgid "replaced {removed} with {added}"
msgstr "已将 {removed} 替换为 {added}"

#: settingsPanel.py:38
#: uTalkCore.py:139
msgid "uTalk"
msgstr "uTalk"

#: uTalkCore.py:436
msgid "uTalk multi tap. Once: swap languages. Twice: open settings. Three times: turn uTalk off or on for the current application. Four times: mute or unmute uTalk announcements"
msgstr "uTalk 多次点击。单击：切换语言。双击：打开设置。三击：为当前应用程序开启或关闭 uTalk。四击：将 uTalk 语音提示静音或取消静音"

#: uTalkCore.py:457
msgid "uTalk muted"
msgstr "uTalk 已静音"

#: uTalkCore.py:474
msgid "uTalk off for {appName}"
msgstr "uTalk 已在 {appName} 中关闭"

#: uTalkCore.py:471
msgid "uTalk on for {appName}"
msgstr "uTalk 已在 {appName} 中开启"

#: uTalkCore.py:457
msgid "uTalk unmuted"
msgstr "uTalk 已取消静音"

#: uTalkCore.py:109
msgid "whitespace"
msgstr "空白字符"