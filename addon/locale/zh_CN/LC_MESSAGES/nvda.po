#: settingsPanel.py:84
msgid "&Application rules (one per line: name=off, name=main or name=alt):"
msgstr "&应用程序规则（每行一个：name=off、name=main 或 name=alt）："

#: uTalkCore.py:62
msgid "...truncated"
msgstr "...已截断"

#: uTalkCore.py:483
msgid "Alternate language"
msgstr "备用语言"

#: settingsPanel.py:57
msgid "Alternate language code:"
msgstr "备用语言代码："

#: uTalkCore.py:505
msgid "Alternate language is not set. Press the shortcut twice to open the uTalk settings and add phrases."
msgstr "未设置备用语言。按两次快捷键以打开 uTalk 设置并添加短语。"

#: settingsPanel.py:79
msgid "Announce copy, cut and paste &only when they take effect"
msgstr "仅在复制、剪切和粘贴&生效时播报"

#: settingsPanel.py:72
msgid "Announcement &detail:"
msgstr "播报&详细程度："

#: settingsPanel.py:64
msgid "Announcement &output:"
msgstr "播报&输出方式："

#: settingsPanel.py:19
msgid "Beep only"
msgstr "仅蜂鸣"

#: settingsPanel.py:18
msgid "Braille only"
msgstr "仅盲文"

#: uTalkCore.py:466
msgid "Cannot detect the current application"
msgstr "无法检测当前应用程序"

#: settingsPanel.py:103
msgid "Command translations:"
msgstr "命令翻译："

#: settingsPanel.py:92
msgid "Copy"
msgstr "复制"

#: settingsPanel.py:94
msgid "Copy file"
msgstr "复制文件"

#: settingsPanel.py:93
msgid "Copy path"
msgstr "复制路径"

