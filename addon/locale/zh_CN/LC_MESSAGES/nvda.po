msgid "Detailed (adds counts and what undo or redo changed)"
msgstr "详细（增加计数以及撤消或重做的更改内容）"

#: uTalkCore.py:484
msgid "English"
msgstr "英语"

#: settingsPanel.py:130
msgid "Invalid configuration"
msgstr "配置无效"

#: settingsPanel.py:148
msgid "Line {line} of the application rules is not valid. Use name=off, name=main or name=alt."
msgstr "应用程序规则的第 {line} 行无效。请使用 name=off、name=main 或 name=alt。"

#: uTalkCore.py:449
msgid "Mute or unmute uTalk announcements"
msgstr "静音或取消静音 uTalk 播报"

#: uTalkCore.py:93
msgid "Nothing to copy"
msgstr "没有可复制的内容"

#: uTalkCore.py:92
msgid "Nothing to cut"
msgstr "没有可剪切的内容"

#: settingsPanel.py:96
msgid "Paste"
msgstr "粘贴"

#: settingsPanel.py:97
msgid "Redo"
msgstr "重做"

#: settingsPanel.py:115
msgid "Restore Defaults"
msgstr "恢复默认值"

#: settingsPanel.py:98
msgid "Save"
msgstr "保存"

#: settingsPanel.py:99
msgid "Select all"
msgstr "全选"

#: settingsPanel.py:25
msgid "Short"
msgstr "简短"

#: settingsPanel.py:16
msgid "Speech and braille"
msgstr "语音和盲文"

#: settingsPanel.py:17
msgid "Speech only"
msgstr "仅语音"

#: settingsPanel.py:134
msgid "The text is longer than {limit} characters. Shorten it before saving."
msgstr "文本长度超过 {limit} 个字符。保存前请将其缩短。"

