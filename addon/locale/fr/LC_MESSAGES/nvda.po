#: settingsPanel.py:84
msgid "&Application rules (one per line: name=off, name=main or name=alt):"
msgstr "&Règles d'application (une par ligne : nom=off, nom=main ou nom=alt) :"

#: uTalkCore.py:62
msgid "...truncated"
msgstr "...tronqué"

#: uTalkCore.py:483
msgid "Alternate language"
msgstr "Langue alternative"

#: settingsPanel.py:57
msgid "Alternate language code:"
msgstr "Code de langue alternatif :"

#: uTalkCore.py:505
msgid "Alternate language is not set. Press the shortcut twice to open the uTalk settings and add phrases."
msgstr "La langue alternative n'est pas définie. Appuyez deux fois sur le raccourci pour ouvrir les paramètres de uTalk et ajouter des expressions."

#: settingsPanel.py:79
msgid "Announce copy, cut and paste &only when they take effect"
msgstr "Annoncer la copie, la coupe et le collage &uniquement lorsqu'ils prennent effet"

#: settingsPanel.py:72
msgid "Announcement &detail:"
msgstr "&Détail des annonces :"

#: settingsPanel.py:64
msgid "Announcement &output:"
msgstr "&Sortie des annonces :"

#: settingsPanel.py:19
msgid "Beep only"
msgstr "Bip uniquement"

#: settingsPanel.py:18
msgid "Braille only"
msgstr "Braille uniquement"

#: uTalkCore.py:466
msgid "Cannot detect the current application"
msgstr "Impossible de détecter l'application actuelle"

#: settingsPanel.py:103
msgid "Command translations:"
msgstr "Traductions de commandes :"

#: settingsPanel.py:92
msgid "Copy"
msgstr "Copier"

#: settingsPanel.py:94
msgid "Copy file"
msgstr "Copier le fichier"

#: settingsPanel.py:93
msgid "Copy path"
msgstr "Copier le chemin"

#: uTalkCore.py:477
msgid "Could not save the application rule"
msgstr "Impossible d'enregistrer la règle d'application"

#: settingsPanel.py:95
msgid "Cut"
msgstr "Couper"

#: settingsPanel.py:26
msgid "Detailed (adds counts and what undo or redo changed)"
msgstr "Détaillé (ajoute les nombres et ce que la fonction Annuler ou Rétablir a modifié)"

#: uTalkCore.py:484
msgid "English"
msgstr "Anglais"

#: settingsPanel.py:130
msgid "Invalid configuration"
msgstr "Configuration non valide"

#: settingsPanel.py:148
msgid "Line {line} of the application rules is not valid. Use name=off, name=main or name=alt."
msgstr "La ligne {line} des règles d'application n'est pas valide. Utilisez nom=off, nom=main ou nom=alt."

#: uTalkCore.py:449
msgid "Mute or unmute uTalk announcements"
msgstr "Activer ou désactiver les annonces uTalk"

#: uTalkCore.py:93
msgid "Nothing to copy"
msgstr "Rien à copier"

#: uTalkCore.py:92
msgid "Nothing to cut"
msgstr "Rien à couper"

#: settingsPanel.py:96
msgid "Paste"
msgstr "Coller"

#: settingsPanel.py:97
msgid "Redo"
msgstr "Rétablir"

#: settingsPanel.py:115
msgid "Restore Defaults"
msgstr "Restaurer les paramètres par défaut"

#: settingsPanel.py:98
msgid "Save"
msgstr "Enregistrer"

#: settingsPanel.py:99
msgid "Select all"
msgstr "Tout sélectionner"

#: settingsPanel.py:25
msgid "Short"
msgstr "Court"

#: settingsPanel.py:16
msgid "Speech and braille"
msgstr "Parole et braille"

#: settingsPanel.py:17
msgid "Speech only"
msgstr "Parole uniquement"

#: settingsPanel.py:134
msgid "The text is longer than {limit} characters. Shorten it before saving."
msgstr "Le texte dépasse {limit} caractères. Veuillez le raccourcir avant d'enregistrer."

#: uTalkCore.py:459
msgid "Turn uTalk off or on for the current application"
msgstr "Activer ou désactiver uTalk pour l'application active"

#: settingsPanel.py:100
msgid "Undo"
msgstr "Annuler"

#: uTalkCore.py:134
msgid "added {text}"
msgstr "{text} ajouté"

#: uTalkCore.py:132
msgid "removed {text}"
msgstr "{text} supprimé"

#: uTalkCore.py:127
msgid "replaced {removed} with {added}"
msgstr "{removed} remplacé par {added}"

#: settingsPanel.py:38
#: uTalkCore.py:139
msgid "uTalk"
msgstr "uTalk"

#: uTalkCore.py:436
msgid "uTalk multi tap. Once: swap languages. Twice: open settings. Three times: turn uTalk off or on for the current application. Four times: mute or unmute uTalk announcements"
msgstr "Multi-pression uTalk. Une fois : inverser les langues. Deux fois : ouvrir les paramètres. Trois fois : activer ou désactiver uTalk pour l'application active. Quatre fois : couper ou rétablir le son des annonces uTalk"

#: uTalkCore.py:457
msgid "uTalk muted"
msgstr "uTalk mis en sourdine"

#: uTalkCore.py:474
msgid "uTalk off for {appName}"
msgstr "uTalk désactivé pour {appName}"

#: uTalkCore.py:471
msgid "uTalk on for {appName}"
msgstr "uTalk activé pour {appName}"

#: uTalkCore.py:457
msgid "uTalk unmuted"
msgstr "Son de uTalk rétabli"

#: uTalkCore.py:109
msgid "whitespace"
msgstr "espace"