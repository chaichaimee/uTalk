#: settingsPanel.py:64
msgid "Announcement &output:"
msgstr "&เอาต์พุตการประกาศ:"

#: settingsPanel.py:19
msgid "Beep only"
msgstr "ส่งเสียงบี๊บเท่านั้น"

#: settingsPanel.py:18
msgid "Braille only"
msgstr "อักษรเบรลล์เท่านั้น"

#: uTalkCore.py:466
msgid "Cannot detect the current application"
msgstr "ไม่สามารถตรวจพบแอปพลิเคชันปัจจุบันได้"

#: settingsPanel.py:103
msgid "Command translations:"
msgstr "การแปลคำสั่ง:"

#: settingsPanel.py:92
msgid "Copy"
msgstr "คัดลอก"

#: settingsPanel.py:94
msgid "Copy file"
msgstr "คัดลอกไฟล์"

#: settingsPanel.py:93
msgid "Copy path"
msgstr "คัดลอกเส้นทาง"

#: uTalkCore.py:477
msgid "Could not save the application rule"
msgstr "ไม่สามารถบันทึกกฎของแอปพลิเคชันได้"

#: settingsPanel.py:95
msgid "Cut"
msgstr "ตัด"

#: settingsPanel.py:26
msgid "Detailed (adds counts and what undo or redo changed)"
msgstr "โดยละเอียด (เพิ่มจำนวนและสิ่งที่เลิกทำหรือทำซ้ำเปลี่ยนแปลง)"

#: uTalkCore.py:484
msgid "English"
msgstr "ภาษาอังกฤษ"

#: settingsPanel.py:130
msgid "Invalid configuration"
msgstr "การกำหนดค่าไม่ถูกต้อง"

#: settingsPanel.py:148
msgid "Line {line} of the application rules is not valid. Use name=off, name=main or name=alt."
msgstr "บรรทัดที่ {line} ของกฎแอปพลิเคชันไม่ถูกต้อง ใช้ name=off, name=main หรือ name=alt"

#: uTalkCore.py:449
msgid "Mute or unmute uTalk announcements"
msgstr "ปิดหรือเปิดเสียงประกาศของ uTalk"

#: uTalkCore.py:93
msgid "Nothing to copy"
msgstr "ไม่มีอะไรให้คัดลอก"

#: uTalkCore.py:92
msgid "Nothing to cut"
msgstr "ไม่มีอะไรให้ตัด"

#: settingsPanel.py:96
msgid "Paste"
msgstr "วาง"

#: settingsPanel.py:97
msgid "Redo"
msgstr "ทำซ้ำ"

#: settingsPanel.py:115
msgid "Restore Defaults"
msgstr "คืนค่าเริ่มต้น"

#: settingsPanel.py:98
msgid "Save"
msgstr "บันทึก"

#: settingsPanel.py:99
msgid "Select all"
msgstr "เลือกทั้งหมด"

#: settingsPanel.py:25
msgid "Short"
msgstr "สั้น"

#: settingsPanel.py:16
msgid "Speech and braille"
msgstr "เสียงพูดและอักษรเบรลล์"

#: settingsPanel.py:17
msgid "Speech only"
msgstr "เสียงพูดเท่านั้น"

#: settingsPanel.py:134
msgid "The text is longer than {limit} characters. Shorten it before saving."
msgstr "ข้อความยาวเกิน {limit} ตัวอักษร โปรดทำให้สั้นลงก่อนบันทึก"

#: uTalkCore.py:459
msgid "Turn uTalk off or on for the current application"
msgstr "ปิดหรือเปิด uTalk สำหรับแอปพลิเคชันปัจจุบัน"

#: settingsPanel.py:100
msgid "Undo"
msgstr "เลิกทำ"

#: uTalkCore.py:134
msgid "added {text}"
msgstr "เพิ่ม {text} แล้ว"

#: uTalkCore.py:132
msgid "removed {text}"
msgstr "ลบ {text} แล้ว"

#: uTalkCore.py:127
msgid "replaced {removed} with {added}"
msgstr "แทนที่ {removed} ด้วย {added}"

#: settingsPanel.py:38
#: uTalkCore.py:139
msgid "uTalk"
msgstr "uTalk"

#: uTalkCore.py:436
msgid "uTalk multi tap. Once: swap languages. Twice: open settings. Three times: turn uTalk off or on for the current application. Four times: mute or unmute uTalk announcements"
msgstr "uTalk มัลติแทป ครั้งเดียว: สลับภาษา สองครั้ง: เปิดการตั้งค่า สามครั้ง: ปิดหรือเปิด uTalk สำหรับแอปพลิเคชันปัจจุบัน สี่ครั้ง: ปิดหรือเปิดเสียงประกาศของ uTalk"

#: uTalkCore.py:457
msgid "uTalk muted"
msgstr "ปิดเสียง uTalk แล้ว"

#: uTalkCore.py:474
msgid "uTalk off for {appName}"
msgstr "ปิด uTalk สำหรับ {appName} แล้ว"

#: uTalkCore.py:471
msgid "uTalk on for {appName}"
msgstr "เปิด uTalk สำหรับ {appName} แล้ว"

#: uTalkCore.py:457
msgid "uTalk unmuted"
msgstr "เปิดเสียง uTalk แล้ว"

#: uTalkCore.py:109
msgid "whitespace"
msgstr "ช่องว่าง"